# ============================================================
# Candidate Workspace — Root .gitignore
# ============================================================

# Environment & secrets
.env
*.env
*.pem
*.key

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Scratch & task logs
*.log
.DS_Store
Thumbs.db
*.db
*.sqlite3

# Large generated datasets (reproducible via generator)
**/data/master/*.csv
**/data/transactions/*.csv
!**/data/ground_truth/**
!**/data/exports/**
!**/data/source_manifest.json

# IDE
.vscode/
.idea/
