# ============================================================
# Compensation Equity System — .gitignore
# ============================================================

# Environment secrets
.env

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Test & build artifacts
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Logs
*.log

# OS artefacts
.DS_Store
Thumbs.db

# Local databases (SQLite scratch)
*.db
*.sqlite3

# Large generated data directories (reproducible via python src/generator/generate.py)
/data/master/*.csv
/data/transactions/*.csv
!/data/ground_truth/**
!/data/exports/**

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Keep exports and documentation in git
# (data/exports/ and documentation/ are intentionally NOT ignored)
